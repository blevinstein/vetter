[Desktop Entry]
Type=Application
Name=Vetter
GenericName=Command Approval Gate
Comment=Approve or reject commands an AI agent wants to run
Icon=dev.vetter.daemon
Exec=vetterd
Terminal=false
Categories=Utility;Security;
# The daemon owns its own lifecycle (`vet daemon start`) and has no
# launchable window before Phase 6d, so this entry exists for identity,
# not for launching: it is what makes `desktop-entry=dev.vetter.daemon`
# on a notification resolve to the Vetter name and shield icon instead
# of a generic placeholder. See plans/LinuxApp.md §5.2.
NoDisplay=true
